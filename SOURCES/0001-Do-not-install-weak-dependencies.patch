From a3a6de5c87a0f0acb520bb989cfcf3954dabe09f Mon Sep 17 00:00:00 2001
From: Olivier Lambert <olivier.lambert@vates.tech>
Date: Sun, 4 Oct 2026 12:53:18 +0200
Subject: [PATCH 1/6] Do not install weak dependencies

xenopsd requires python3-scapy, whose Recommends (ipython3, matplotlib,
PyX) drag in 113 texlive packages: their file triggers alone
(fmtutil-sys --all) cost ~30s of install time. Overall 264 of the 803
packages only come in as weak dependencies.

EL10 only recommends some packages a host needs (linux-firmware
sub-packages, CPU microcode, filesystem tools): request them explicitly
until xcp-ng-deps requires them.
---
 repository.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/repository.py b/repository.py
index c7b8313..3a9429a 100644
--- a/repository.py
+++ b/repository.py
@@ -96,6 +96,7 @@ installonlypkgs=
 distroverpkg=xenserver-release
 reposdir=/tmp/repos
 history_record=false
+install_weak_deps=False
 """ % cachedir
 
 def _quoteDnfString(s):
@@ -890,6 +891,14 @@ baseurl=%s
         for repo in repos:
             if repo._targets:
                 targets += repo._targets
+        # With install_weak_deps=False, packages that EL10 only pulls in as
+        # Recommends must be requested explicitly (should move to xcp-ng-deps).
+        targets += ['e2fsprogs', 'xfsprogs', 'dosfstools', 'diffutils', 'jq', 'pigz',
+                    'amd-ucode-firmware', 'realtek-firmware', 'amd-gpu-firmware',
+                    'intel-gpu-firmware', 'nvidia-gpu-firmware', 'atheros-firmware',
+                    'brcmfmac-firmware', 'mt7xxx-firmware', 'nxpwireless-firmware',
+                    'tiwilink-firmware', 'intel-audio-firmware', 'cirrus-audio-firmware',
+                    'polkit', 'tpm2-tools', 'unbound-anchor']
         targets = list(set(targets))
 
         installFromYum(targets, mounts, progress_callback, cachedir)
